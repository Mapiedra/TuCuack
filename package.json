{
  "name": "tucuack",
  "version": "0.1.0",
  "description": "TuCuack — mascota de escritorio Tamagotchi con chat social entre patos",
  "main": "src/main/main.js",
  "author": "Mapiedra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mapiedra/TuCuack.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "sprites": "python tools/pack_sprites.py",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.mapiedra.tucuack",
    "productName": "TuCuack",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/sprites/spritesheet-source.webp",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": ".",
        "filter": [
          "supabase.json"
        ],
        "to": "."
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/tucuack.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TuCuack"
    },
    "publish": {
      "provider": "github",
      "owner": "Mapiedra",
      "repo": "TuCuack"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  }
}
