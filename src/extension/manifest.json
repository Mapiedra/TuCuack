{
  "manifest_version": 3,
  "name": "TuCuack",
  "version": "0.0.0",
  "description": "Tu pato tamagotchi, paseando por las páginas que visitas.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "TuCuack"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "128": "assets/icons/tucuack.png"
  },
  "web_accessible_resources": [
    {
      "comentario": "El content script trae el núcleo con import() dinámico, así que sus módulos y los sprites tienen que ser alcanzables desde la página donde vive el pato.",
      "resources": [
        "core/*",
        "assets/*",
        "platform-pagina.js",
        "almacen.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
